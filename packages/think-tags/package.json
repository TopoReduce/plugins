{
  "name": "@jianmu/middleware-think-tags",
  "version": "0.1.2",
  "description": "Take a model's leading <think>, <thinking> or <thought> block out of its reply's text, or put a Chat reply's reasoning_content into it (New API's thinking_to_content), as magpie gateway middleware",
  "type": "module",
  "files": [
    "think-tags.middleware.js",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "new-api",
    "reasoning",
    "think",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TopoReduce/plugins.git",
    "directory": "packages/think-tags"
  },
  "magpie": {
    "middleware": "./think-tags.middleware.js",
    "options": {
      "mode": "strip"
    }
  },
  "jianmu": {
    "middleware": "./think-tags.middleware.js",
    "options": {
      "mode": "strip"
    }
  }
}
